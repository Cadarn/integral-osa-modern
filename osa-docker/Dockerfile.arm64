# syntax=docker/dockerfile:1
# Native ARM64 (aarch64) Container for Apple Silicon & AWS Graviton / GCP Tau
FROM --platform=linux/arm64 ubuntu:22.04 AS builder-arm64

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gfortran \
    gcc \
    g++ \
    cmake \
    git \
    curl \
    wget \
    ca-certificates \
    libcfitsio-dev \
    libgsl-dev \
    libreadline-dev \
    libncurses5-dev \
    libx11-dev \
    libxpm-dev \
    libxft-dev \
    libxext-dev \
    libglu1-mesa-dev \
    libgl1-mesa-dev \
    zlib1g-dev \
    libbz2-dev \
    libssl-dev \
    libsqlite3-dev \
    rsync \
    patch \
    file \
    python3 \
    python3-dev \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install uv from official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Setup /opt/venv with astronomy & pipeline tools
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv venv /opt/venv && \
    uv sync --frozen --no-install-project --no-dev --active

# Final Runtime Stage (Lean ARM64 Image)
FROM --platform=linux/arm64 ubuntu:22.04 AS runtime-arm64

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    wget \
    ca-certificates \
    libgfortran5 \
    libcfitsio9 \
    libgsl27 \
    libreadline8 \
    libncurses5 \
    libx11-6 \
    libxpm4 \
    libxft2 \
    libxext6 \
    libglu1-mesa \
    libgl1-mesa-glx \
    zlib1g \
    libbz2-1.0 \
    libssl3 \
    libsqlite3-0 \
    python3 \
    make \
    file \
    && rm -rf /var/lib/apt/lists/*

# Copy uv and Python virtual environment
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
COPY --from=builder-arm64 /opt/venv /opt/venv

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Setup directories for OSA and reference catalogs
RUN mkdir -pv /data/cat/hec /data/cat/omc /data/scw /data/aux /data/ic /data/idx /opt/osa /opt/heasoft

# Init scripts & tests from osa-docker directory
COPY osa-docker/init.sh /init.sh
COPY osa-docker/init.d /init.d
COPY osa-docker/tests /tests

# Default environment variables
ENV ISDC_REF_CAT=/data/cat/hec/gnrl_refr_cat_0043.fits
ENV ISDC_OMC_CAT=/data/cat/omc/omc_refr_cat_0005.fits
ENV REP_BASE_PROD=/data
ENV CURRENT_IC=/data
ENV ISDC_ENV=/opt/osa
ENV HOME_OVERRIDE=/home/integral

WORKDIR /home/integral
ENTRYPOINT ["/bin/bash", "-c", "source /init.sh && exec \"$@\"", "--"]
CMD ["bash"]
